{
  "name": "toae",
  "version": "0.1.3",
  "description": "Translate OCR AutoHotkey Electron",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "helper:fmt": "cargo fmt --manifest-path native-helper/Cargo.toml -- --check",
    "helper:check": "cargo check --locked --manifest-path native-helper/Cargo.toml",
    "helper:build:win": "cargo build --locked --release --target x86_64-pc-windows-gnu --manifest-path native-helper/Cargo.toml && node scripts/copy-helper.mjs",
    "dist:win": "npm run build && npm run helper:build:win && electron-builder --win --x64",
    "dist:win:nsis": "npm run build && npm run helper:build:win && electron-builder --win nsis --x64",
    "dist:win:zip": "npm run build && npm run helper:build:win && electron-builder --win zip --x64"
  },
  "dependencies": {
    "ace-builds": "1.33.2",
    "animate.css": "4.1.1",
    "color": "4.2.3",
    "crypto-js": "4.2.0",
    "element-plus": "2.7.3",
    "jsonpath-plus": "9.0.0",
    "tinyld": "1.3.4",
    "uuid": "9.0.1",
    "vue": "3.4.27",
    "vue3-ace-editor": "2.2.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.13",
    "@types/color": "4.2.1",
    "@types/crypto-js": "4.2.2",
    "@types/node": "24.13.3",
    "@types/uuid": "9.0.8",
    "@vitejs/plugin-vue": "5.0.4",
    "@vitejs/plugin-vue-jsx": "3.1.0",
    "autoprefixer": "10.4.19",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "postcss": "8.4.38",
    "sass": "1.77.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "unplugin-element-plus": "0.8.0",
    "vite": "5.2.11",
    "vite-plugin-svg-icons": "2.0.1",
    "vitest": "1.6.1",
    "vue-tsc": "2.0.29"
  },
  "build": {
    "appId": "com.danger-dream.toae",
    "productName": "TOAE",
    "executableName": "TOAE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist-electron/main/index.cjs",
      "dist-electron/preload/index.cjs",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/win32-x64",
        "to": "win32-x64",
        "filter": [
          "native-helper.exe",
          "AutoHotkey_H.dll",
          "resource-manifest.json"
        ]
      },
      {
        "from": "resources/default-script.ahk",
        "to": "default-script.ahk"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "TOAE-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
